{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "harness gate claudecode PostToolUse",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "harness gate claudecode PreToolUse",
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "harness gate claudecode SessionStart",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "harness gate claudecode Stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
